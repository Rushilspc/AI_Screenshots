{
  "name": "ai-screenshots-app",
  "version": "0.1.0",
  "description": "Offline AI-powered searchable screenshots for Windows",
  "main": "dist/main/main.js",
  "author": "AI Screenshots",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer/bundle.js --platform=browser --format=iife --loader:.tsx=tsx --loader:.ts=ts --loader:.css=css && node scripts/postbuild-renderer.mjs",
    "dev": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run test:packaging && tsc -p tsconfig.test.json && node .tmp/tests/tests/ranking.test.js && node .tmp/tests/tests/ai.test.js",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "test:packaging": "node scripts/verify-packaging-paths.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "electron-store": "^10.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "electron": "^35.0.3",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2",
    "electron-builder": "^24.13.3"
  }
}